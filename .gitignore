# colcon build outputs
build/
install/
log/

# runtime data - never commit
# data/ holds the admin password hash; secrets.env the Gmail app password
data/
secrets.env

# YOLO weights (auto-downloaded by ultralytics)
*.pt

__pycache__/
*.pyc

# saved maps are personal to each deployment (commit them if you want
# to keep a map in the repo - by default they stay local)
maps/*.pgm
maps/*.yaml
maps/*.data
maps/*.posegraph

# logs / evidence
compliance_robot_logs/

# training artifacts (at the repository root only: evidence/**/runs/ is kept)
/datasets/
/runs/

# TTS voice models (downloaded by setup, ~60MB)
voices/

# camera spots are deployment data (dashboard writes them)
maps/cameras.json

# demo recordings (large video files)
recordings/
# The simulation map + camera spots (maps/sim/) ARE committed in this
# repository: the evaluation depends on them.
maps/real_room_backup/
# base/dock spots are deployment data too (dashboard writes them)
maps/bases.json

# --- simulation evaluation (publication) ---
# Run recordings: several GB, published separately (see evaluation/README.md)
evaluation/data/
**/bag/
*.db3
# Phase 7 patch staging copy (the reviewable diff is evaluation/pending_phase7.diff)
evaluation/pending_phase7_patch/
