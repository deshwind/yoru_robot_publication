<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yoru_sim_plugins</name>
  <version>1.0.0</version>
  <description>
    Gazebo classic plugins for the Yoru simulation evaluation: a ROS-driven
    human actor (animated, with a lidar-visible collision body) used by the
    simulated human response model.
  </description>
  <maintainer email="deshwind02@gmail.com">Deshwin Dharile</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
