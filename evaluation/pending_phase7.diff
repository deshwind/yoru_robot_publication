+def without_support(weights):
+    """C5 ablation: drop the support term and renormalise the other weights
+    so they keep their relative sizes and still sum to the original total."""
+    rest = weights['w_D'] + weights['w_P'] + weights['w_T']
+    total = rest + weights['w_S']
+    return {'w_D': weights['w_D'] * total / rest, 'w_P': weights['w_P'] * total / rest,
+            'w_T': weights['w_T'] * total / rest, 'w_S': 0.0}
+
