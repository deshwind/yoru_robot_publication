+# ----------------------------------------------------- Phase 7 ablations
+
+def c7_conflict_frame():
+    """Cigarette below the 0.75 override + phone at the mouth (B-C7)."""
+    frame = scenario_a_frame()
+    frame.detections[1].results[0].hypothesis.score = 0.70
+    px, py, ph = 320.0, 240.0, 150.0
+    frame.detections.append(det('mobile_phone', 0.8, px - 10, py - ph / 2 + 0.18 * ph + 4, 20, 30))
+    return frame
+
+
+def test_ablations_default_off(ros):
+    node = make_node()
+    try:
+        assert node.ablations() == []
+        assert node.weights() == rule.DEFAULT_WEIGHTS
+    finally:
+        node.destroy_node()
+
+
+def test_ablate_c4_confirms_on_the_first_frame(ros):
+    node = make_node()
+    try:
+        node.set_parameters([Parameter('ablate_c4', value=True)])
+        node.tracked_callback(scenario_a_frame())
+        last = node.metadata_pub.msgs[-1].data
+        # C = 0.312 + 0.24 + 0.2 * (1/5) + 0.05 = 0.642 >= 0.6, C4 no longer required
+        assert '"status": "confirmed"' in last and '"C4_persistence": false' in last
+    finally:
+        node.destroy_node()
+
+
+def test_ablate_c5_renormalises_without_support(ros):
+    node = make_node()
+    try:
+        node.set_parameters([Parameter('ablate_c5', value=True)])
+        w = node.weights()
+        assert w['w_S'] == 0.0 and abs(sum(w.values()) - 1.0) < 1e-12
+        assert abs(w['w_D'] / w['w_P'] - 0.4 / 0.3) < 1e-12
+        for _ in range(5):
+            node.tracked_callback(scenario_a_frame())
+        # (0.4*0.78 + 0.3*0.8 + 0.2*1.0) / 0.9 = 0.8356
+        assert '"confidence": 0.836' in node.metadata_pub.msgs[-1].data
+    finally:
+        node.destroy_node()
+
+
+def test_ablate_c7_lets_the_conflict_through(ros):
+    for ablate, expected in ((False, 'uncertain'), (True, 'confirmed')):
+        node = make_node()
+        try:
+            node.set_parameters([Parameter('ablate_c7', value=ablate)])
+            for _ in range(5):
+                node.tracked_callback(c7_conflict_frame())
+            meta = [m.data for m in node.metadata_pub.msgs if 'possible_vape' not in m.data]
+            assert f'"status": "{expected}"' in meta[-1], (ablate, meta[-1])
+            assert '"C7_fp_risk": "high"' in meta[-1]      # raw risk still reported
+        finally:
+            node.destroy_node()
+
